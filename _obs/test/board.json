{
  "uid": "laug-lint-fixture",
  "title": "laug · lint fixture",
  "description": "make obs-test's fixture for make lint's board rules: one board that keeps every rule of _obs/lint.sh. make obs-test lints it, then plants one fault at a time in a copy and expects exit 2. Not provisioned anywhere.",
  "tags": ["laug", "test"],
  "timezone": "utc",
  "editable": false,
  "graphTooltip": 1,
  "refresh": "10s",
  "schemaVersion": 39,
  "version": 1,
  "time": {"from": "now-15m", "to": "now"},
  "links": [],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {"type": "grafana", "uid": "-- Grafana --"},
        "enable": true,
        "hide": true,
        "iconColor": "#D99A3A",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "datasource": {"type": "prometheus", "uid": "laug-store"},
        "enable": true,
        "iconColor": "#D99A3A",
        "name": "Timeline",
        "expr": "laug_gate_step_seconds{gate_id=\"$gate\"} * 1000",
        "step": "5s",
        "titleFormat": "{{step}} {{item}}",
        "useValueForTime": true
      },
      {
        "datasource": {"type": "prometheus", "uid": "laug-store"},
        "enable": true,
        "iconColor": "#D99A3A",
        "name": "Fault marks",
        "expr": "laug_fault_mark_seconds{gate_id=\"$gate\"} * 1000",
        "step": "5s",
        "titleFormat": "{{mark}} {{item}}",
        "useValueForTime": true
      },
      {
        "datasource": {"type": "prometheus", "uid": "laug-store"},
        "enable": true,
        "iconColor": "#D99A3A",
        "name": "Role restarts",
        "expr": "changes(restarts{gate_id=\"$gate\"}[30s]) > 0",
        "step": "30s",
        "titleFormat": "{{job}} restarted"
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "gate",
        "type": "query",
        "datasource": {"type": "prometheus", "uid": "laug-store"},
        "query": {"query": "label_values(laug_gate_info, gate_id)", "refId": "v"},
        "definition": "label_values(laug_gate_info, gate_id)",
        "refresh": 2,
        "multi": false,
        "includeAll": false,
        "hide": 0,
        "current": {},
        "options": [],
        "sort": 0
      },
      {
        "name": "rel_cell",
        "type": "query",
        "datasource": {"type": "prometheus", "uid": "laug-store"},
        "query": {"query": "label_values(laug_item_info{gate_id=\"$gate\", arm=\"release\"}, cell)", "refId": "v"},
        "definition": "label_values(laug_item_info{gate_id=\"$gate\", arm=\"release\"}, cell)",
        "refresh": 2,
        "multi": false,
        "includeAll": false,
        "hide": 2,
        "current": {},
        "options": [],
        "sort": 0
      },
      {
        "name": "fault",
        "type": "query",
        "datasource": {"type": "prometheus", "uid": "laug-store"},
        "query": {"query": "label_values(laug_item_info{gate_id=\"$gate\", kind=\"fault\"}, item)", "refId": "v"},
        "definition": "label_values(laug_item_info{gate_id=\"$gate\", kind=\"fault\"}, item)",
        "refresh": 2,
        "multi": false,
        "includeAll": false,
        "hide": 0,
        "current": {},
        "options": [],
        "sort": 0
      },
      {
        "name": "fault_cell",
        "type": "query",
        "datasource": {"type": "prometheus", "uid": "laug-store"},
        "query": {"query": "label_values(laug_item_info{gate_id=\"$gate\", item=\"$fault\"}, cell)", "refId": "v"},
        "definition": "label_values(laug_item_info{gate_id=\"$gate\", item=\"$fault\"}, cell)",
        "refresh": 2,
        "multi": false,
        "includeAll": false,
        "hide": 2,
        "current": {},
        "options": [],
        "sort": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Verdict",
      "description": "Copied from verdict.json once the judge wrote it: ADVANCE or BLOCK, and its class.",
      "datasource": {"type": "prometheus", "uid": "laug-store"},
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "fixed", "fixedColor": "#CFE3E4"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "#CFE3E4", "value": null}]},
          "mappings": [],
          "noValue": "not written yet: the judge has not run"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "name",
        "justifyMode": "center",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "laug-store"},
          "refId": "A",
          "expr": "laug_gate_verdict{gate_id=\"$gate\"}",
          "legendFormat": "{{verdict}} {{class}}",
          "range": false,
          "instant": true,
          "editorMode": "code"
        }
      ]
    },
    {
      "id": 2,
      "type": "bargauge",
      "title": "Persistence p99 against its max (so far, store)",
      "description": "The yaml's query with one cell selector, over the board's range; the max is the gate's own laug_threshold.",
      "datasource": {"type": "prometheus", "uid": "laug-store"},
      "gridPos": {"x": 6, "y": 0, "w": 9, "h": 4},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "fixed", "fixedColor": "#5FB3BF"},
          "unit": "ms",
          "thresholds": {"mode": "absolute", "steps": [{"color": "#5FB3BF", "value": null}]},
          "mappings": []
        },
        "overrides": [
          {
            "matcher": {"id": "byFrameRefID", "options": "max"},
            "properties": [
              {"id": "color", "value": {"mode": "fixed", "fixedColor": "#C44B32"}},
              {"id": "custom.lineStyle", "value": {"fill": "dash", "dash": [10, 10]}}
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "orientation": "horizontal",
        "displayMode": "basic",
        "valueMode": "color",
        "namePlacement": "auto",
        "showUnfilled": true,
        "sizing": "auto",
        "minVizWidth": 8,
        "minVizHeight": 16,
        "maxVizHeight": 300
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "laug-store"},
          "refId": "persistence_latency_p99_ms",
          "expr": "histogram_quantile(0.99, sum(rate(persistence_latency_bucket{cell=~\"$rel_cell\"}[$__range])) by (le)) * 1000",
          "legendFormat": "release",
          "range": false,
          "instant": true,
          "editorMode": "code"
        },
        {
          "datasource": {"type": "prometheus", "uid": "laug-store"},
          "refId": "max",
          "expr": "laug_threshold{gate_id=\"$gate\", reading=\"persistence_latency_p99_ms\"}",
          "legendFormat": "max",
          "range": false,
          "instant": true,
          "editorMode": "code"
        }
      ]
    },
