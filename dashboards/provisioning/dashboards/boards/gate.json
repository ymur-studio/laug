  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "service error rate, 1 m (not the verdict)",
      "datasource": {
        "type": "prometheus",
        "uid": "laug-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "laug-prometheus"
          },
          "expr": "(sum(rate(service_error_with_type{error_type!=\"serviceerror_Canceled\"}[1m])) or vector(0)) / sum(rate(service_requests[1m]))",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#5FB3BF",
                "value": null
              },
              {
                "color": "#C44B32",
                "value": 0.001
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      }
    },
